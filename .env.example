# Variables read by docker-compose.yml itself (not by the application).
# Copy to `.env` at the repository root before running `docker compose up`.
#
# POSTGRES_PASSWORD is REQUIRED and has no default: compose refuses to start
# without it, so a weak fallback can never reach a deployed environment.
# Generate one and use the SAME value in backend/.env:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_USER=legallink
POSTGRES_PASSWORD=
POSTGRES_DB=legallink
POSTGRES_PORT=5432

REDIS_PORT=6379
PORT=8000
